# PEGASUS OS — Environment Configuration
# Copy this file to .env and fill in your values.

# AI Model API Keys
PEGASUS_OPENAI_API_KEY=
PEGASUS_ANTHROPIC_API_KEY=

# Model Selection
PEGASUS_OPENAI_MODEL=gpt-4
PEGASUS_ANTHROPIC_MODEL=claude-3-opus-20240229
PEGASUS_USE_LOCAL_MODEL=false

# Server
PEGASUS_HOST=0.0.0.0
PEGASUS_PORT=8420

# Agent Settings
PEGASUS_MAX_AGENT_RETRIES=3
PEGASUS_MAX_AGENT_RUNTIME_SECONDS=300
PEGASUS_LOG_LEVEL=INFO
