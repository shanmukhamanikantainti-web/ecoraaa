# PEGASUS / ECORAA OS — Environment Configuration Example
# Copy this file to .env and fill in your actual private values.

# OpenRouter Configuration (BACKEND ONLY — Never expose to frontend or git)
PEGASUS_OPENROUTER_API_KEY=
PEGASUS_OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
PEGASUS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Server
PEGASUS_HOST=0.0.0.0
PEGASUS_PORT=8420

# Agent Settings
PEGASUS_MAX_AGENT_RETRIES=3
PEGASUS_MAX_AGENT_RUNTIME_SECONDS=300
PEGASUS_LOG_LEVEL=INFO
